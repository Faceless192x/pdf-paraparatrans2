# 使用する翻訳APIを設定してください。
# - ローカル: このファイルを `.env` にコピーして値を入れる
# - GitHub Codespaces: Codespaces Secrets を環境変数として渡す（`.env` は不要）

TRANSLATOR=google
# TRANSLATOR=deepl
# TRANSLATOR=ollama

# ※値が空なら未設定扱いです（プレースホルダ文字列は入れないでください）
GOOGLE_API_KEY=
DEEPL_AUTH_KEY=

# ログフォルダ
LOG_DIR=logs

# Flaskの設定
PORT=5077
# LOG_LEVEL:DEBUG,INFO,WARNING,ERROR,CRITICAL
LOG_LEVEL=WARNING
# Codespacesなどで分割アップロードへ切り替える閾値（MB）
CHUNK_UPLOAD_THRESHOLD_MB=15
# PDFアップロード最大サイズ（MB）。通常/分割アップロードの両方に適用
MAX_PDF_UPLOAD_MB=300
# 追加でCORSを許可したいoriginがあればカンマ区切りで指定
# 既定では localhost / 127.0.0.1 / ::1 とブラウザ拡張(origin)のみ許可
# PARAPARATRANS_CORS_ALLOWED_ORIGINS=

# Google翻訳v3の設定
# TRANSLATOR=google_v3
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=us-central1
# GOOGLE_GLOSSARY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# （任意）DEBUG_TOKEN_PREFIX=1

# Ollama（ローカルLLM）の設定 — APIキー不要
# TRANSLATOR=ollama
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_BASE_URL=http://localhost:11434

# 生成AI統合レイヤーの設定（翻訳以外の生成タスク用）
# AI_PROVIDER=ollama
# （OllamaプロバイダはOLLAMA_MODEL / OLLAMA_BASE_URL を流用）
# OpenAIプロバイダ（将来対応）
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini (Google AI Studio) の設定 — 無料枠あり
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# 取得先: https://aistudio.google.com/
